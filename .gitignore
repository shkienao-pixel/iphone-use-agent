# Temporary checks and local recordings
*.log
*.tmp
__pycache__/
*.pyc
/.cache/
/recordings/
/exports/
/local-data/

# One-time development imports and local verification
model-config.once.json
*.receipt.json
/verification-local/

# Reproducible local baseline, builds and acceptance evidence
/output/
